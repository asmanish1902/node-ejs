<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Error <%= statusCode %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet"/>
</head>
<body class="bg-light">

  <nav class="navbar navbar-dark bg-dark px-4">
    <a href="/users" class="navbar-brand fw-bold">
      <i class="bi bi-people-fill me-2"></i>User Management
    </a>
  </nav>

  <div class="container py-5">
    <div class="row justify-content-center mt-5">
      <div class="col-md-6 text-center">

        <div class="card shadow-sm border-0">
          <div class="card-body py-5">

            <h1 class="display-1 fw-bold <%= statusCode === 404 ? 'text-warning' : 'text-danger' %>">
              <%= statusCode %>
            </h1>

            <h4 class="mb-3">
              <% if (statusCode === 404) { %>
                <i class="bi bi-search me-2"></i>Page Not Found
              <% } else { %>
                <i class="bi bi-exclamation-triangle me-2"></i>Something Went Wrong
              <% } %>
            </h4>

            <p class="text-muted mb-4"><%= message %></p>

            <a href="/users" class="btn btn-primary">
              <i class="bi bi-house me-2"></i>Go Back Home
            </a>

            <% if (stack) { %>
              <div class="mt-4 text-start">
                <div class="alert alert-secondary">
                  <p class="fw-bold mb-2 text-danger">
                    <i class="bi bi-bug me-1"></i>Stack Trace (development only)
                  </p>
                  <pre class="mb-0" style="font-size:0.75rem; overflow-x:auto;
                    white-space: pre-wrap;"><%= stack %></pre>
                </div>
              </div>
            <% } %>

          </div>
        </div>

      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>