<%- include('partials/header', { title: 'Add User' }) %>

<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-header bg-white">
        <h5 class="mb-0"><i class="bi bi-person-plus me-2"></i>Add New User</h5>
      </div>
      <div class="card-body">

        <%- include('partials/alert') %>

        <form action="/users" method="POST">

          <div class="mb-3">
            <label class="form-label fw-semibold">Full Name</label>
            <input
              type="text"
              name="name"
              value="<%= old.name || '' %>"
              class="form-control <%= errors.name ? 'is-invalid' : '' %>"
              placeholder="Enter full name"
            />
            <% if (errors.name) { %>
              <div class="invalid-feedback"><%= errors.name %></div>
            <% } %>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Email Address</label>
            <input
              type="email"
              name="email"
              value="<%= old.email || '' %>"
              class="form-control <%= errors.email ? 'is-invalid' : '' %>"
              placeholder="Enter email"
            />
            <% if (errors.email) { %>
              <div class="invalid-feedback"><%= errors.email %></div>
            <% } %>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Role</label>
            <select name="role" class="form-select <%= errors.role ? 'is-invalid' : '' %>">
              <option value="">-- Select Role --</option>
              <% ['Developer', 'Designer', 'Manager', 'Admin'].forEach(r => { %>
                <option value="<%= r %>" <%= old.role === r ? 'selected' : '' %>>
                  <%= r %>
                </option>
              <% }) %>
            </select>
            <% if (errors.role) { %>
              <div class="invalid-feedback"><%= errors.role %></div>
            <% } %>
          </div>

          <div class="mb-4">
            <label class="form-label fw-semibold">Status</label>
            <select name="status" class="form-select <%= errors.status ? 'is-invalid' : '' %>">
              <option value="">-- Select Status --</option>
              <option value="Active"   <%= old.status === 'Active'   ? 'selected' : '' %>>Active</option>
              <option value="Inactive" <%= old.status === 'Inactive' ? 'selected' : '' %>>Inactive</option>
            </select>
            <% if (errors.status) { %>
              <div class="invalid-feedback"><%= errors.status %></div>
            <% } %>
          </div>

          <div class="d-grid gap-2">
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-check-lg me-1"></i> Save User
            </button>
            <a href="/users" class="btn btn-outline-secondary">Cancel</a>
          </div>

        </form>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>